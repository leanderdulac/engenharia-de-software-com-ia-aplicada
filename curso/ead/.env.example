# Cópia local: cp .env.example .env  (o ficheiro .env não vai para o Git)
# Nenhuma chave de nuvem. Auth é local (scrypt + sessão no SQLite).

HOST=127.0.0.1
PORT=3850

# Ficheiro SQLite (persistência real). Fora do Git.
EAD_DATA_DIR=./data

# Cookies Secure= só em HTTPS. Dev HTTP local deixa 0.
# NODE_ENV=production exige 1 (TLS termina na borda; o processo fala HTTP).
EAD_SECURE_COOKIES=0

# 1 atrás de proxy (Render). O IP real entra no limite de login.
# EAD_TRUST_PROXY=1

# Produção: auto-registo fechado. 1 volta a abrir o formulário público.
# EAD_OPEN_SIGNUP=0

# Criar admin (CLI). Não commite a senha.
# EAD_ADMIN_EMAIL=admin@local.test
# EAD_ADMIN_PASSWORD=

# Seed DEMONSTRAÇÃO/TESTE (nunca em instalação real de turma).
# EAD_SEED_DEMO=1
# EAD_DEMO_INSTRUCTOR_PASSWORD=
# EAD_DEMO_ALUNO_A_PASSWORD=
# EAD_DEMO_ALUNO_B_PASSWORD=

# Adaptadores explicitamente desligados (não ligar sem implementação real):
# EAD_SMTP_URL=
# EAD_SSO_ISSUER=
# EAD_BILLING=
